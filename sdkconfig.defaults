# Project Kconfig defaults (applied when sdkconfig.<env> is regenerated).
# NodeMCU v2/v3: 4 MB flash, DIO mode.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y

# %f in snprintf for the values JSON (nano format has no floats)
# CONFIG_NEWLIB_NANO_FORMAT is not set

# UART0 — консоль измерителя: логи SDK выключены на компиляции
# (esp_log_level_set — no-op без CONFIG_LOG_SET_LEVEL). Свои DBG — на UART1.
CONFIG_LOG_DEFAULT_LEVEL_NONE=y

# ретрансмиссий до разрыва: мёртвый пир с недоставленными данными
# закрывается за ~1.5 мин вместо ~9 (дефолт 12) - анти-фриз.
# Окно отправки TCP не ужимаем: lwIP sanity-check требует
# TCP_SND_BUF >= 2*MSS = 2880, меньше - ошибка сборки
CONFIG_LWIP_TCP_MAXRTX=6

# дерево параметров прибора живёт в NVS: раздел 64К (partitions.csv)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y
